# PostgreSQL Database (Neon / Supabase) Connection URLs
# Untuk Neon:
# DATABASE_URL: Menggunakan connection string pooling (dari Dashboard Neon: Connection pooling ON)
# DIRECT_URL: Menggunakan direct connection string (dari Dashboard Neon: Connection pooling OFF)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

